    ("Enemy", "A", "America")
}

# Rules with their names and explanations
rules = [
    {
        "name": "R1",
        "conditions": [("Missile", "?x")],
        "conclusion": ("Weapon", "?x"),
        "formula": "Missile(x) -> Weapon(x)",
